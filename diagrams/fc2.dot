digraph FC2 {
  graph [rankdir=TB, bgcolor=white, fontname="Times New Roman", nodesep=0.35, ranksep=0.42, pad=0.22];
  node [fontname="Times New Roman", fontsize=12, style=filled, fillcolor="#F2F2F2", color=black, penwidth=1.3];
  edge [fontname="Times New Roman", fontsize=11, arrowsize=0.75];

  s   [shape=ellipse, label="Garment at second\nsize segregation"];
  cl  [shape=box, label="Active checklist selected\n(style + colour declared)"];
  bc  [shape=box, label="Scan hangtag barcode\n— decoded ON the phone"];
  ctx [shape=diamond, label="Style and colour match\nthe checklist context?"];
  rej [shape=box, fillcolor="#D9D9D9", label="REJECT — out of context\nnotify operator · log event"];

  ocr [shape=box, label="Read neck label\n(see Figure 4.4)"];
  nr  [shape=diamond, label="Label read?"];
  fb  [shape=box, label="Manual fallback\n(see Figure 4.4)"];

  map [shape=box, label="Resolve BOTH sizes to canonical\nvia per-buyer size code map"];
  cmp [shape=diamond, label="Neck label size\n=  hangtag size?"];
  mm  [shape=box, fillcolor="#D9D9D9", label="MISMATCH\nalert operator · record mismatch\nquarantine garment"];
  okn [shape=box, fillcolor="#D9D9D9", label="MATCH\nincrement verified count"];
  e   [shape=ellipse, label="Verdict recorded\nbefore the carton"];

  s -> cl -> bc -> ctx;
  ctx -> rej [label="  no"];
  ctx -> ocr [label="  yes"];
  ocr -> nr;
  nr  -> fb  [label="  no"];
  nr  -> map [label="  yes"];
  fb  -> map;
  map -> cmp;
  cmp -> mm  [label="  no"];
  cmp -> okn [label="  yes"];
  mm  -> e;  okn -> e;  rej -> e;
}
