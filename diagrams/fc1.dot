digraph FC1 {
  graph [rankdir=TB, bgcolor=white, fontname="Times New Roman", nodesep=0.35, ranksep=0.42, pad=0.22];
  node [fontname="Times New Roman", fontsize=12, style=filled, fillcolor="#F2F2F2", color=black, penwidth=1.3];
  edge [fontname="Times New Roman", fontsize=11, arrowsize=0.75];

  start  [shape=ellipse, label="Garment presented"];
  cap    [shape=box, label="Capture neck-label image\n(crop · compress)"];
  send   [shape=box, label="Send image + active size set\nto recognition service"];
  net    [shape=diamond, label="Service\nreachable?"];
  queue  [shape=box, label="Store scan locally\nmark queued\nshow “verdict pending”"];
  retry  [shape=box, label="Retry in background"];

  rot    [shape=box, label="Try rotation θ\n(0°, 90°, 180°, 270°)"];
  ocr    [shape=box, label="EasyOCR → raw text"];
  parse  [shape=box, label="Search text for a size\nin THIS shipment's size set"];
  found  [shape=diamond, label="Candidate\nfound?"];
  more   [shape=diamond, label="More\nrotations?"];

  resolve[shape=box, label="Resolve against\nper-buyer size code map"];
  ok     [shape=box, fillcolor="#D9D9D9", label="Size established\noutcome = correct / wrong read"];
  noread [shape=box, fillcolor="#D9D9D9", label="outcome = NO READ"];
  fb     [shape=box, label="Manual fallback entry"];
  logex  [shape=box, label="Log exception\nlink to recognition_result\n(NULL ⇒ bypass — DP3)"];
  endn   [shape=ellipse, label="Size recorded.\nNo garment blocked."];

  start -> cap -> send -> net;
  net   -> queue [label="  no"];
  queue -> retry;
  retry -> net   [label="  on reconnect", style=dashed];
  net   -> rot   [label="  yes"];
  rot   -> ocr -> parse -> found;
  found -> resolve [label="  yes"];
  found -> more    [label="  no"];
  more  -> rot     [label="  yes"];
  more  -> noread  [label="  no"];
  resolve -> ok;
  noread  -> fb -> logex -> endn;
  ok      -> endn;
}
