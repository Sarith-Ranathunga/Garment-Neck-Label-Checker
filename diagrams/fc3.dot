digraph FC3 {
  graph [rankdir=TB, bgcolor=white, fontname="Times New Roman", nodesep=0.35, ranksep=0.42, pad=0.22];
  node [fontname="Times New Roman", fontsize=12, style=filled, fillcolor="#F2F2F2", color=black, penwidth=1.3];
  edge [fontname="Times New Roman", fontsize=11, arrowsize=0.75];

  s    [shape=ellipse, label="Carton packing"];
  open [shape=box, label="Open carton\nscan carton number"];
  scan [shape=box, label="Scan each garment into carton"];
  ver  [shape=diamond, label="Garment verified\nat Stage 5?"];
  warn [shape=box, fillcolor="#D9D9D9", label="Warn: unverified garment\nlog event"];
  add  [shape=box, label="Add to carton_item\nincrement count"];
  more [shape=diamond, label="Carton\nfull?"];
  close[shape=box, label="Close carton\nrecord close time"];
  last [shape=diamond, label="Shipment\ncomplete?"];

  rec  [shape=box, fillcolor="#D9D9D9", label="FOUR-POINT RECONCILIATION\nallocation → Stage 1 → Stage 5 → Stage 6"];
  bal  [shape=diamond, label="All four\nagree?"];
  div  [shape=box, fillcolor="#D9D9D9", label="Report divergence by size\n— do not generate list"];
  gen  [shape=box, label="Generate packing list\nstyle-wise, buyer format"];
  gap  [shape=box, label="Declare unpopulated fields\nin the field map"];
  e    [shape=ellipse, label="Packing list issued"];

  s -> open -> scan -> ver;
  ver  -> warn [label="  no"];
  ver  -> add  [label="  yes"];
  warn -> add;
  add  -> more;
  more -> scan  [label="  no"];
  more -> close [label="  yes"];
  close -> last;
  last -> open [label="  no"];
  last -> rec  [label="  yes"];
  rec  -> bal;
  bal  -> div [label="  no"];
  bal  -> gen [label="  yes"];
  gen  -> gap -> e;
  div  -> e;
}
