# Copy to .env and edit for the machine this runs on.
GNLC_DB_PASSWORD=change-me

# Mount point of the ENCRYPTED USB drive.
#   Windows:  E:/gnlc-backup
#   Linux:    /media/usb/gnlc-backup
GNLC_USB_PATH=./_backup

# Minutes between backups and exports.
GNLC_BACKUP_MINUTES=15
GNLC_EXPORT_MINUTES=15
